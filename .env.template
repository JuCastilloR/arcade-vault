# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio.

# API key de Resend (empieza por re_). Solo se lee en app/api/contact/route.ts.
RESEND_API_KEY=

# Destino de los mensajes del formulario de contacto.
# En el sandbox de Resend (onboarding@resend.dev) solo se entrega al correo
# dueño de la cuenta de Resend, así que debe ser ese mismo correo.
CONTACT_TO_EMAIL=

# Remitente. Para pasar a dominio propio verificado, solo cambia este valor.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>
